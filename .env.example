# Postgres connection string (Vercel Postgres or Supabase both work — any standard Postgres URL)
DATABASE_URL=postgres://user:password@host:5432/breakpoint

# Resend (transactional email)
RESEND_API_KEY=re_xxx
EMAIL_FROM="Breakpoint <hello@audit.shotoku.dev>"
# Where the operator (Issa) gets notified of new submissions / verification events
OPERATOR_EMAIL=you@shotoku.dev

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
# Absolute base URL of this app, used for Stripe redirect URLs and verification links
NEXT_PUBLIC_BASE_URL=https://audit.shotoku.dev

# Admin
# Plain password the operator uses to sign in to /admin. Keep this out of source control.
ADMIN_PASSWORD=change-me
# Random long string used to sign the admin session cookie
ADMIN_SESSION_SECRET=change-me-too
